#################################
# Device                        #
#################################

device:
  # Shown as the device name in Home Assistant, and used to derive every
  # entity_id (same slugify() rule as TuxD/the Linux agent) - keep this
  # stable once set, the same as any TuxD device.
  name: ""
  # Prints connection/discovery activity to the console - useful the first
  # time you run this by hand, noisy under a Scheduled Task.
  tty_output: false
  refresh_entities: 300
  # Default mdi icon shown for this agent wherever TuxD-Cards displays it
  # (e.g. the device-status grid card) - purely cosmetic.
  agent_icon: "mdi:microsoft-windows"
  self_update_check_interval: 300
  # Whether the "TuxD-Win Agent Update" entity's Install action exists at
  # all - off means check-only, an admin still has to update by hand.
  self_update_allow_install: true

#################################
# Home Assistant (direct mode)  #
#################################

home-assistant:
  # Must be https:// - see allow_insecure below. Same pairing/approval flow
  # as any TuxD device: paste the integration's pairing key below to
  # introduce this host, then approve it from Configure > Review new
  # devices, which issues api_key.
  url: ""
  pairing_key: ""
  api_key: ""
  verify_ssl: true
  retry_delay: 15
  # Only set this true for a fully isolated/already-trusted LAN - see
  # TuxD's own tuxd.conf for why this defaults to refusing plain http://.
  allow_insecure: false

#################################
# Metrics                       #
#################################

# CPU/RAM - one combined loop (psutil makes sampling both together
# essentially free), unlike TuxD's separate per-metric config blocks.
metrics:
  enabled: true
  update_interval: 15

network:
  enabled: true
  update_interval: 5

disks:
  enabled: true
  update_interval: 60
  # Empty = auto-detect every fixed drive (psutil.disk_partitions). List
  # specific drive letters (e.g. ["C:\\", "D:\\"]) to limit which ones are
  # monitored. Each monitored drive gets its own used %/used GB/free GB
  # sensors named like TuxD's per-disk ones: C:\ is "root"
  # (sensor.<host>_root_storage_used, ..._root_storage_used_gb,
  # ..._root_free_space), any other drive is named by its letter
  # (D:\ -> sensor.<host>_d_storage_used). The combined storage_used_gb/
  # free_gb/used_pct sensors add up every monitored drive.
  drives: []

#################################
# Windows services               #
#################################

# One binary_sensor per listed service name (as Windows itself names it,
# e.g. "Spooler", "wuauserv", "W32Time" - not the display name shown in
# services.msc). Check-only, same as host_update below - this never starts/
# stops/restarts a service on its own.
services:
  enabled: true
  update_interval: 30
  names: []

#################################
# Windows Update                #
#################################

# Detection only - see modules/host_update_agent.py's docstring for why
# this never installs updates itself. Checking is relatively expensive
# (can take anywhere from a few seconds to over a minute), hence the long
# default interval.
host_update:
  enabled: true
  check_interval: 3600
